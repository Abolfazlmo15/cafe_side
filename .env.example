# Copy this file to .env and fill in real values.

LOCAL=-1

# Local database (XAMPP defaults)
LOCAL_DB_HOST=localhost
LOCAL_DB_NAME=your_local_db_name
LOCAL_DB_USER=root
LOCAL_DB_PASS=
LOCAL_DB_PORT=3306
LOCAL_BASE_URL=http://localhost/your-project

# Production database (your host)
PROD_DB_HOST=your-host-db.example.com
PROD_DB_NAME=your_prod_db_name
PROD_DB_USER=your_prod_user
PROD_DB_PASS=your_prod_password
PROD_DB_PORT=3306
PROD_BASE_URL=https://your-domain.com

# Shared
SITE_NAME=Cafe Side
ADMIN_PASS_FALLBACK=ChangeMeOnProd!
MAX_TABLES_FALLBACK=20

APP_ENV=development

OPENROUTER_API_KEY=sk-your-api-key